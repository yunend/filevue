    "build-linuxarm": "pkg . --targets node12.22.11-linux-arm64 --output ./dist/filevue-linux-arm64",
    "build-mac": "pkg . --targets node12.22.11-macos-x64 --output ./dist/filevue-macos-x64"
  },
